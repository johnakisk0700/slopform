NODE_ENV=production

# The deployment script overrides this with the exact checked-out Git SHA.
RELEASE_TAG=replace-with-git-sha

# Edge / TLS. Point DOMAIN to the VPS before starting Caddy.
DOMAIN=app.legacy.example.com
ACME_EMAIL=ops@legacy.example.com

# Application
WEB_ORIGIN=https://app.legacy.example.com

# Clerk. The two publishable values must match and are public by design. Keep
# the secret in its own mode-0600 file and explicitly approve admin subjects.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_ADMIN_USER_IDS=user_replace_me
CLERK_SECRET_KEY_FILE=./secrets/clerk_secret_key

# Optional AI provider secret files. Configure at least one non-empty file to
# enable assistant generation; OpenRouter supplies the default Gemini model.
OPENROUTER_API_KEY_FILE=./secrets/openrouter_api_key
OPENAI_API_KEY_FILE=./secrets/openai_api_key

# Wasender webhook is intentionally off until the durable message consumer is
# deployed. Generate/configure the same strong secret in Wasender when enabling.
WASENDER_SESSION_API_KEY_FILE=./secrets/wasender_session_api_key
WASENDER_WEBHOOK_ENABLED=false
WASENDER_WEBHOOK_SECRET_FILE=./secrets/wasender_webhook_secret

# Secret files must contain independent, URL-safe passwords. Paths are resolved
# from the project directory; keep the files outside Git and unencrypted backups.
POSTGRES_DB=join_the_six
POSTGRES_USER=join_the_six
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
DATABASE_POOL_MAX=10

# MongoDB keeps conversation threads and ordered turns. The root secret is used
# only when initializing a fresh volume; API and worker receive only the
# database-scoped application credential.
MONGODB_DB=join_the_six
MONGODB_APP_USER=join_the_six
MONGODB_ROOT_USER=join_the_six_root
MONGODB_APP_PASSWORD_FILE=./secrets/mongodb_app_password
MONGODB_ROOT_PASSWORD_FILE=./secrets/mongodb_root_password

REDIS_PASSWORD_FILE=./secrets/redis_password

# One-shot migration bounds in milliseconds. Lock < statement < execution.
MIGRATION_CONNECT_TIMEOUT_MS=10000
MIGRATION_LOCK_TIMEOUT_MS=15000
MIGRATION_STATEMENT_TIMEOUT_MS=300000
MIGRATION_EXECUTION_TIMEOUT_MS=600000

# Observability: enable OTLP or Sentry tracing, not both.
LOG_LEVEL=info
OTEL_SERVICE_NAME=join-the-six
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Dashboard stays off unless it is intentionally exposed and authenticated.
BULL_BOARD_ENABLED=false
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD_FILE=./secrets/bull_board_password
REFERENCE_MODULE_ENABLED=false
