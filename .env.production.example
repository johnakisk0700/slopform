NODE_ENV=production

# The production CLI owns these component tags. Keeping them separate makes an
# admin-only or backend-only rollout restart-correct instead of pretending every
# running container came from the newest commit.
MIGRATE_RELEASE_TAG=replace-with-git-sha
API_RELEASE_TAG=replace-with-git-sha
WORKER_RELEASE_TAG=replace-with-git-sha
WEB_RELEASE_TAG=replace-with-git-sha

# Native nginx already owns TLS on the shared VPS. Docker publishes only these
# loopback ports; changing either also requires changing
# deploy/nginx/slopform.example.com.conf.
DOMAIN=slopform.example.com
API_HOST_PORT=5201
WEB_HOST_PORT=5200

# Application
WEB_ORIGIN=https://slopform.example.com

# Clerk. The two publishable values must match and are public by design. Keep
# the secret in its own mode-0600 file locally. Compose file-backed secrets are
# bind mounts, so the VPS copies are mode 0644 inside a root-only mode-0700
# directory; otherwise non-root containers cannot read them. Use the dedicated
# Restricted production instance, invite exactly the three shareholders, then
# put their stable Clerk user IDs here. Emails are admission input, never API
# authorization.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_ADMIN_USER_IDS=user_replace_one,user_replace_two,user_replace_three
CLERK_SECRET_KEY_FILE=./secrets/clerk_secret_key

# Optional public, HTTP-referrer-restricted browser key for Places API (New)
# autocomplete, Places UI Kit details and Maps Embed fallback.
# Leave empty to keep the no-JavaScript-API venue fallback.
VITE_GOOGLE_MAPS_API_KEY=

# Optional AI provider secret files. Routing is model-specific and never falls
# back. OpenRouter supplies Gemini and Qwen; OpenAI direct supplies Luna/Terra.
OPENROUTER_API_KEY_FILE=./secrets/openrouter_api_key
OPENAI_API_KEY_FILE=./secrets/openai_api_key

# Model-specific worker configuration. Empty extraction values keep the Gemini
# default and provider-default effort. Summary values keep Terra at xhigh.
FEEDBACK_EXTRACTION_MODEL=
FEEDBACK_EXTRACTION_REASONING_EFFORT=
FEEDBACK_ATTENTION_REASONING_EFFORT=
FEEDBACK_EXTRACTION_SERVICE_TIER=
FEEDBACK_SUMMARY_MODEL=
FEEDBACK_SUMMARY_REASONING_EFFORT=
FEEDBACK_REMINDER_AFTER_HOURS=24
FEEDBACK_MAX_REMINDERS=2
FEEDBACK_EXPIRE_AFTER_HOURS=72
FEEDBACK_INGRESS_PENDING_RECOVERY_MINUTES=5
FEEDBACK_OPERATOR_ALERT_MODE=log
# Initial production is an authenticated rehearsal environment: real models,
# durable simulated delivery, manual participant-message injection, no Wasender
# egress. All three values are intentional; without the production rehearsal
# gate the backend refuses this configuration.
FEEDBACK_PRODUCTION_REHEARSAL_ENABLED=true
FEEDBACK_SIMULATOR_ENABLED=true
FEEDBACK_EXTRACTION_STUB=false

# Wasender stays disconnected during the production rehearsal. Keep both files
# empty; TRANSPORT_MODE=simulated writes only to the durable local sink.
WASENDER_SESSION_API_KEY_FILE=./secrets/wasender_session_api_key
WASENDER_WEBHOOK_ENABLED=false
WASENDER_WEBHOOK_SECRET_FILE=./secrets/wasender_webhook_secret
TRANSPORT_MODE=simulated

# Secret files must contain independent, URL-safe passwords. Paths are resolved
# from the project directory; keep the files outside Git and unencrypted backups.
POSTGRES_DB=join_the_six
POSTGRES_USER=join_the_six
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
DATABASE_POOL_MAX=10

# MongoDB keeps conversation threads and ordered turns. The root secret is used
# only when initializing a fresh volume; API and worker receive only the
# database-scoped application credential.
MONGODB_DB=join_the_six
MONGODB_APP_USER=join_the_six
MONGODB_ROOT_USER=join_the_six_root
MONGODB_APP_PASSWORD_FILE=./secrets/mongodb_app_password
MONGODB_ROOT_PASSWORD_FILE=./secrets/mongodb_root_password

REDIS_PASSWORD_FILE=./secrets/redis_password

# One-shot migration bounds in milliseconds. Lock < statement < execution.
MIGRATION_CONNECT_TIMEOUT_MS=10000
MIGRATION_LOCK_TIMEOUT_MS=15000
MIGRATION_STATEMENT_TIMEOUT_MS=300000
MIGRATION_EXECUTION_TIMEOUT_MS=600000

# Observability: enable OTLP or Sentry tracing, not both.
LOG_LEVEL=info
OTEL_SERVICE_NAME=join-the-six
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Dashboard stays off unless it is intentionally exposed and authenticated.
BULL_BOARD_ENABLED=false
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD_FILE=./secrets/bull_board_password
REFERENCE_MODULE_ENABLED=false
