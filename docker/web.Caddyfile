# Static file server for the admin SPA inside the `web` image.
# The production edge (root Caddyfile) terminates TLS and proxies here; this
# server only hands out the built client.
:3000 {
	root * /srv
	encode zstd gzip

	# Client-side routing: unknown paths fall back to the SPA shell so a hard
	# refresh on /admin still boots the application.
	try_files {path} /index.html
	file_server

	header {
		-Server
		X-Content-Type-Options "nosniff"
	}

	log
}
