# A subdirectory avoids overlapping the distribution's /var/log/nginx/*.log rule.
/var/log/nginx/slopform/*.log {
    daily
    rotate 14
    maxsize 10M
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        /usr/sbin/nginx -s reopen
    endscript
}
