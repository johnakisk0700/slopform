# Dependencies and package-manager state
node_modules/
.pnpm-store/

# Build output and caches
.turbo/
.nuxt/
.output/
dist/
coverage/
**/coverage/coverage-final.json
*.tsbuildinfo

# `report/` holds two unrelated kinds of thing. The burst rehearsal's HTML
# reports are read once and are large — 5.6 MB for sixteen runs — and other
# tools drop their own output here too. The runner's JSON summaries are the
# opposite: each is a few kilobytes and is the only record of which model ran
# against which commit, and sixteen runs of them existed on exactly one laptop
# for as long as this directory was ignored wholesale. Hence ignoring the
# contents and re-including just the runner's own summaries; the directory
# itself must stay unignored or git would never look inside it to find them.
report/*
!report/feedback-burst-*.json

# Deterministic orval output from apps/backend/openapi/openapi.json
apps/admin/src/api/generated/

# Environment and local secrets
.env
.env.*
!.env.example
!.env.*.example
secrets/

# Logs and runtime files
*.log
*.pid

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Local database tooling
.drizzle/

# Claude Code. `launch.json` is committed on purpose — it is what lets the
# preview tooling start the admin dev server, so it belongs to the project
# rather than to one machine. The other two do not: `settings.local.json` is a
# personal permission list, and `worktrees/` holds full checkouts an isolated
# agent run left behind (hundreds of megabytes each). Prune those with
# `git worktree list` and `git worktree remove`, not by deleting the directory —
# they are registered worktrees and one may still hold uncommitted work.
.claude/settings.local.json
.claude/worktrees/
