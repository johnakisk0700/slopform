{
  "name": "@slopform/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "predev": "pnpm --filter @slopform/database build && pnpm run build",
    "dev": "concurrently --kill-others --names compiler,http,worker \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --import ./dist/instrumentation.js ./dist/main-http.js\" \"node --watch --import ./dist/instrumentation.js ./dist/main-worker.js\"",
    "predev:http": "pnpm --filter @slopform/database build && pnpm run build",
    "dev:http": "concurrently --kill-others --names compiler,http \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --import ./dist/instrumentation.js ./dist/main-http.js\"",
    "predev:worker": "pnpm --filter @slopform/database build && pnpm run build",
    "dev:worker": "concurrently --kill-others --names compiler,worker \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --import ./dist/instrumentation.js ./dist/main-worker.js\"",
    "import:wordpress-profiles": "node ./dist/cli/import-wordpress-profiles.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "openapi:emit": "node ./dist/cli/emit-openapi.js",
    "start:http": "node --import ./dist/instrumentation.js ./dist/main-http.js",
    "start:worker": "node --import ./dist/instrumentation.js ./dist/main-worker.js",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.18",
    "@bull-board/api": "8.1.2",
    "@bull-board/express": "8.1.2",
    "@bull-board/nestjs": "8.1.2",
    "@clerk/express": "2.1.44",
    "@slopform/database": "workspace:*",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@sentry/nestjs": "10.67.0",
    "ai": "7.0.35",
    "bullmq": "5.80.10",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "mongodb": "7.5.0",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.4.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.3",
    "pino-pretty": "13.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.11 <25"
  }
}
