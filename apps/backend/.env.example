# Direct backend commands read this file from apps/backend. Root `pnpm dev`
# injects the repository-root .env instead.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Local-only authentication escape hatch. Rejected when NODE_ENV=production.
AUTH_DEV_BYPASS=false

# Clerk HTTP authentication. CLERK_ADMIN_USER_IDS is a comma-separated,
# server-side allowlist; a valid Clerk session alone is not admin authorization.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ADMIN_USER_IDS=

# Tool-free assistant generation. Routing is exact: Gemini/Qwen use OpenRouter,
# while Luna/Terra use OpenAI direct. No credential is a fallback for another.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Explicit paid-rehearsal profile. The dev scenario runner verifies the model;
# it never overrides it per run. This does not change the assistant default.
FEEDBACK_EXTRACTION_MODEL=openai/gpt-5.6-luna
FEEDBACK_EXTRACTION_REASONING_EFFORT=xhigh
FEEDBACK_ATTENTION_REASONING_EFFORT=high
# OpenAI scheduling tier for direct-OpenAI extraction models only.
FEEDBACK_EXTRACTION_SERVICE_TIER=
# Campaign summaries default to direct-OpenAI Terra at xhigh.
FEEDBACK_SUMMARY_MODEL=
FEEDBACK_SUMMARY_REASONING_EFFORT=

# The nudge ladder. Nudge N falls due after N × REMINDER_AFTER_HOURS of
# participant silence, capped at MAX_REMINDERS, and a conversation expires
# after EXPIRE_AFTER_HOURS of the same silence. Silence is measured from what
# the participant last said, never from what we sent.
FEEDBACK_REMINDER_AFTER_HOURS=24
FEEDBACK_MAX_REMINDERS=2
FEEDBACK_EXPIRE_AFTER_HOURS=72
FEEDBACK_INGRESS_PENDING_RECOVERY_MINUTES=5
FEEDBACK_OPERATOR_ALERT_MODE=log

# Opt-in Wasender HTTPS webhook. Leave off until staging acceptance and the
# consent gate pass. TRANSPORT_MODE selects the feedback outbound adapter
# (simulated local sink vs paced Wasender sends).
WASENDER_SESSION_API_KEY=
WASENDER_WEBHOOK_ENABLED=false
WASENDER_WEBHOOK_SECRET=
TRANSPORT_MODE=simulated
# Production-only explicit exception for a Clerk-protected, real-model rehearsal.
# It is invalid in development; see the production example for the coherent set.
FEEDBACK_PRODUCTION_REHEARSAL_ENABLED=false
# Manual message endpoints and explicitly confirmed headless scenario evaluation.
# Requires simulated transport.
FEEDBACK_SIMULATOR_ENABLED=false
# Rehearsal-only: make post-event feedback extraction deterministic (scripted
# burst personas instead of a provider). Requires the simulator gate above.
FEEDBACK_EXTRACTION_STUB=false

DATABASE_URL=postgresql://join_the_six:local_only_change_me@localhost:5432/join_the_six
DATABASE_POOL_MAX=10
MONGODB_URI=mongodb://join_the_six:local_only_change_me@localhost:27017/join_the_six?authSource=join_the_six&retryWrites=false
REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug
OTEL_SERVICE_NAME=join-the-six-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Disabled by default. Never enable without credentials and network controls.
BULL_BOARD_ENABLED=false
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=

# Disposable golden module. Leave disabled outside intentional scaffold tests.
REFERENCE_MODULE_ENABLED=false
