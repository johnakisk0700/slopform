# Shared local development defaults. Copy to .env; never commit real credentials.
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NUXT_API_BASE_INTERNAL=http://localhost:4000/api/v1
NUXT_PUBLIC_API_BASE=http://localhost:4000/api/v1

# Optional host port overrides for `pnpm dev:containers`.
API_HOST_PORT=4000
WEB_HOST_PORT=3000

# PostgreSQL
POSTGRES_DB=join_the_six
POSTGRES_USER=join_the_six
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgresql://join_the_six:local_only_change_me@localhost:5432/join_the_six
DATABASE_POOL_MAX=10
POSTGRES_HOST_PORT=5432

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379

# Observability
LOG_LEVEL=debug
OTEL_SERVICE_NAME=join-the-six-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Queue observability. Keep disabled unless protected by credentials/network policy.
BULL_BOARD_ENABLED=false
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=
REFERENCE_MODULE_ENABLED=false

# Transitional WordPress boundary. Populate only in a secret manager.
WORDPRESS_BASE_URL=https://wordpress.example.com
WORDPRESS_SERVICE_TOKEN=
WORDPRESS_WEBHOOK_SECRET=
