# Shared local development defaults. Copy to .env; never commit real credentials.
NODE_ENV=development

# Container process ownership. Defaults match the usual native-Linux account;
# override with `id -u` / `id -g` when your host account differs.
DEV_UID=1000
DEV_GID=1000

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Admin SPA: root-relative by default so the Vite dev proxy (and Caddy in
# production) forward /api to the backend on the same origin.
VITE_API_BASE=/api

# Optional host port overrides for `pnpm dev:containers`.
API_HOST_PORT=4000
WEB_HOST_PORT=3000

# PostgreSQL
POSTGRES_DB=join_the_six
POSTGRES_USER=join_the_six
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgresql://join_the_six:local_only_change_me@localhost:5432/join_the_six
DATABASE_POOL_MAX=10
POSTGRES_HOST_PORT=5432

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379

# Observability
LOG_LEVEL=debug
OTEL_SERVICE_NAME=join-the-six-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Queue observability. Keep disabled unless protected by credentials/network policy.
BULL_BOARD_ENABLED=false
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=
REFERENCE_MODULE_ENABLED=false
