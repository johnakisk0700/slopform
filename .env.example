# Shared local development defaults. Copy to .env; never commit real credentials.
NODE_ENV=development

# Container process ownership. Defaults match the usual native-Linux account;
# override with `id -u` / `id -g` when your host account differs.
DEV_UID=1000
DEV_GID=1000

# API
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
# Admin SPA: root-relative by default so the Vite dev proxy (and Caddy in
# production) forward /api to the backend on the same origin.
VITE_API_BASE=/api

# Local-only escape hatch. When true, both the SPA and API use the stable
# synthetic principal user_localdev. Both runtimes reject it in production.
VITE_AUTH_DEV_BYPASS=false
AUTH_DEV_BYPASS=false

# Clerk. The publishable key is public and must be available to the Vite build;
# the secret key remains backend-only. Copy the matching keys from one Clerk
# application and list only explicitly approved admin user IDs.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ADMIN_USER_IDS=

# Optional public browser key for Places API (New) autocomplete, Places UI Kit
# details and Maps Embed fallback.
# Keep it HTTP-referrer restricted to the admin origins. With no key, operators
# paste a Place ID and every saved venue still has a plain Google Maps link.
VITE_GOOGLE_MAPS_API_KEY=

# AI assistant providers. Routing is model-specific and never falls back:
# OpenRouter serves Gemini and Qwen; OpenAI direct serves Luna and Terra.
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Post-event feedback extraction model (D12). Empty uses the default
# google/gemini-3.6-flash. Any value must be one of the registered model ids in
# assistant-models.ts; an unknown id fails at worker start instead of quietly
# reaching a different provider.
FEEDBACK_EXTRACTION_MODEL=

# Thinking budget for the extraction call: none, low, medium, high, xhigh or max.
# Leave empty to send no reasoning field at all, which is not the same as `none`
# — empty leaves the provider on its own default, `none` overrides it. Reasoning
# tokens are spent from the same output budget as the answer, so anything above
# `none` raises the ceiling to 16,384 (see model.service.ts for the measurement).
# Luna and Terra are routed through OpenAI direct so these values are explicit
# request controls. The paid rehearsal uses Terra medium for extraction and
# attention, plus the low reply writer below.
FEEDBACK_EXTRACTION_REASONING_EFFORT=

# Final participant-facing rewrite. The production rehearsal uses Terra low;
# extraction remains a separate medium-effort decision.
FEEDBACK_REPLY_REASONING_EFFORT=

# Thinking budget for the attention classifier, same vocabulary. Empty means
# `none` here — sent explicitly, which is what this call has always done — so
# leaving it empty changes nothing. Setting it raises that call's ceiling from
# 1,024 to 16,384 the same way. Cost is the reason it stays `none` by default:
# the classifier is billed per message batch across every conversation in the
# campaign, so thinking here multiplies with participants, not with runs.
FEEDBACK_ATTENTION_REASONING_EFFORT=

# OpenAI scheduling tier for all feedback model calls: default, flex or priority. Applied only
# when FEEDBACK_EXTRACTION_MODEL routes direct to OpenAI; an OpenRouter-routed
# model never receives it. Empty omits the field and leaves the account's own
# tier in force. `flex` trades latency for a lower rate; `priority` is OpenAI's
# paid fast mode at roughly 2x the standard token price, charged per token on
# those calls — leave it empty unless you are deliberately timing a rehearsal.
FEEDBACK_EXTRACTION_SERVICE_TIER=

# Campaign summaries remain a separate direct-OpenAI call. Empty uses Terra at
# xhigh; an override must still resolve to a direct-OpenAI registry entry.
FEEDBACK_SUMMARY_MODEL=
FEEDBACK_SUMMARY_REASONING_EFFORT=

# How an operator is notified the first time a feedback conversation needs
# attention (safety tripwire or a permanently failed extraction). `log` emits a
# structured feedback.operator_alert line; `off` keeps the durable
# needsAttention flag without notifying. A WhatsApp adapter is a named future
# extension point, not a supported value.
FEEDBACK_OPERATOR_ALERT_MODE=log

# Reminder and ingress-recovery timing. Empty values use the same defaults;
# explicit values are useful for deliberate time-based local rehearsals.
FEEDBACK_REMINDER_AFTER_HOURS=24
FEEDBACK_MAX_REMINDERS=2
FEEDBACK_EXPIRE_AFTER_HOURS=72
FEEDBACK_INGRESS_PENDING_RECOVERY_MINUTES=5

# The local feedback simulator and burst rehearsal. The production rehearsal
# gate is deliberately invalid in development; production documents its exact
# coherent profile separately. FEEDBACK_EXTRACTION_STUB additionally requires
# the simulator: a scripted model outside it would lie about provider usage.
FEEDBACK_PRODUCTION_REHEARSAL_ENABLED=false
FEEDBACK_SIMULATOR_ENABLED=false
FEEDBACK_EXTRACTION_STUB=false

# Wasender webhook remains off until staging acceptance and the consent gate
# pass. TRANSPORT_MODE=simulated is the local-first outbound adapter (WP6/WP8).
WASENDER_SESSION_API_KEY=
WASENDER_WEBHOOK_ENABLED=false
WASENDER_WEBHOOK_SECRET=
TRANSPORT_MODE=simulated

# Optional host port overrides for `pnpm dev:containers`.
API_HOST_PORT=4000
WEB_HOST_PORT=3000

# PostgreSQL
POSTGRES_DB=join_the_six
POSTGRES_USER=join_the_six
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgresql://join_the_six:local_only_change_me@localhost:5432/join_the_six
DATABASE_POOL_MAX=10
POSTGRES_HOST_PORT=5432

# MongoDB conversation storage. The application user is scoped to MONGODB_DB;
# the root credential exists only to initialize a fresh local container.
MONGODB_DB=join_the_six
MONGODB_APP_USER=join_the_six
MONGODB_APP_PASSWORD=local_only_change_me
MONGODB_ROOT_USER=join_the_six_root
MONGODB_ROOT_PASSWORD=local_only_change_me
MONGODB_URI=mongodb://join_the_six:local_only_change_me@localhost:27017/join_the_six?authSource=join_the_six&retryWrites=false
MONGODB_HOST_PORT=27017

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
REDIS_HOST_PORT=6379

# Observability
LOG_LEVEL=debug
OTEL_SERVICE_NAME=join-the-six-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Queue observability. Keep disabled unless protected by credentials/network policy.
BULL_BOARD_ENABLED=false
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=
REFERENCE_MODULE_ENABLED=false
